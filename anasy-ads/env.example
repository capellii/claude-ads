# Supabase PostgreSQL (Transaction-mode pooler port 6543)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) for Drizzle migrations
DATABASE_URL_DIRECT=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Upstash Redis (ioredis connection string format: redis://:password@host:port)
UPSTASH_REDIS_REST_URL=redis://:password@global-host.upstash.io:6379

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxx

# Google Ads OAuth
GOOGLE_ADS_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=xxxx

# Meta Ads OAuth
META_APP_ID=xxxx
META_APP_SECRET=xxxx

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
